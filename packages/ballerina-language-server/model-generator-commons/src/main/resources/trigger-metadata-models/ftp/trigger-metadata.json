{
  "version": "v1.0",

  "listeners": [
    { "type": { "name": "Listener" }, "services": ["$service"], "multipleServicesAllowed": true }
  ],

  "serviceTypes": [
    {
      "id": "$service",
      "type": { "name": "Service" },
      "concrete": false,
      "multipleListenersAllowed": true,
      "annotations": ["$serviceConfig"],
      "handlers": {
        "backedByConcreteType": false,
        "options": [
          {
            "name": "onFileCsv",
            "kind": "remote",
            "doc": "Invoked for each .csv file found in the watched directory. Declaring a stream parameter reads the file in chunks instead of loading it into memory.",
            "presence": "optional",
            "annotations": ["$functionConfig"],
            "params": [
              {
                "name": "contents",
                "doc": "The parsed rows, see the csvContent data-binding rule for the batched and streamed forms.",
                "type": [
                  { "shape": "array", "elementType": { "shape": "array", "elementType": { "name": "string" } } },
                  { "shape": "array", "elementType": { "name": "record {}" } },
                  {
                    "shape": "stream",
                    "elementType": { "shape": "array", "elementType": { "name": "string" } },
                    "completionType": [{ "name": "error" }, { "name": "()" }]
                  },
                  {
                    "shape": "stream",
                    "elementType": { "name": "record {}" },
                    "completionType": [{ "name": "error" }, { "name": "()" }]
                  }
                ],
                "presence": "required",
                "dataBinding": {
                  "typedescs": [
                    {
                      "constraint": { "shape": "array", "elementType": { "name": "string" } },
                      "shapes": [
                        { "form": "array", "element": "bare" },
                        { "form": "stream", "element": "bare", "completionType": [{ "name": "error" }, { "name": "()" }] }
                      ]
                    },
                    {
                      "constraint": { "name": "record {}" },
                      "shapes": [
                        { "form": "array", "element": "bare" },
                        { "form": "stream", "element": "bare", "completionType": [{ "name": "error" }, { "name": "()" }] }
                      ]
                    }
                  ]
                }
              },
              {
                "name": "fileInfo",
                "doc": "The file's name, path, size, and timestamps.",
                "type": { "name": "FileInfo" },
                "presence": "required"
              },
              {
                "name": "caller",
                "doc": "The FTP connection, for reading or writing other files while this one is being processed.",
                "type": { "name": "Caller" },
                "presence": "optional"
              }
            ],
            "returns": [{ "name": "error" }, { "name": "()" }]
          },
          {
            "name": "onFileJson",
            "kind": "remote",
            "doc": "Invoked for each .json file found in the watched directory.",
            "presence": "optional",
            "annotations": ["$functionConfig"],
            "params": [
              {
                "name": "content",
                "doc": "The parsed content, bind a record type to project it, see the jsonContent data-binding rule.",
                "type": { "name": "json" },
                "presence": "required",
                "dataBinding": {
                  "typedescs": [
                    { "constraint": { "name": "json" }, "shapes": [{ "form": "bare" }] },
                    { "constraint": { "name": "record {}" }, "shapes": [{ "form": "bare" }] }
                  ]
                }
              },
              {
                "name": "fileInfo",
                "doc": "The file's name, path, size, and timestamps.",
                "type": { "name": "FileInfo" },
                "presence": "required"
              }
            ],
            "returns": [{ "name": "error" }, { "name": "()" }]
          },
          {
            "name": "onFileXml",
            "kind": "remote",
            "doc": "Invoked for each .xml file found in the watched directory.",
            "presence": "optional",
            "annotations": ["$functionConfig"],
            "params": [
              {
                "name": "content",
                "doc": "The parsed content, bind a record type to project it, see the xmlContent data-binding rule.",
                "type": { "name": "xml" },
                "presence": "required",
                "dataBinding": {
                  "typedescs": [
                    { "constraint": { "name": "xml" }, "shapes": [{ "form": "bare" }] },
                    { "constraint": { "name": "record {}" }, "shapes": [{ "form": "bare" }] }
                  ]
                }
              },
              {
                "name": "fileInfo",
                "doc": "The file's name, path, size, and timestamps.",
                "type": { "name": "FileInfo" },
                "presence": "required"
              }
            ],
            "returns": [{ "name": "error" }, { "name": "()" }]
          },
          {
            "name": "onFileText",
            "kind": "remote",
            "doc": "Invoked for each plain-text file found in the watched directory.",
            "presence": "optional",
            "annotations": ["$functionConfig"],
            "params": [
              { "name": "content", "doc": "The file's text content.", "type": { "name": "string" }, "presence": "required" },
              {
                "name": "fileInfo",
                "doc": "The file's name, path, size, and timestamps.",
                "type": { "name": "FileInfo" },
                "presence": "required"
              }
            ],
            "returns": [{ "name": "error" }, { "name": "()" }]
          },
          {
            "name": "onFile",
            "kind": "remote",
            "doc": "Invoked for any file no typed handler matched, and as the fallback when a typed handler is not declared. Content arrives as raw bytes.",
            "presence": "optional",
            "annotations": ["$functionConfig"],
            "params": [
              {
                "name": "content",
                "doc": "The file's bytes. Declare the stream form to read large files in chunks rather than loading them into memory.",
                "type": [
                  { "shape": "array", "elementType": { "name": "byte" } },
                  {
                    "shape": "stream",
                    "elementType": { "shape": "array", "elementType": { "name": "byte" } },
                    "completionType": [{ "name": "error" }, { "name": "()" }]
                  }
                ],
                "presence": "required"
              },
              {
                "name": "fileInfo",
                "doc": "The file's name, path, size, and timestamps.",
                "type": { "name": "FileInfo" },
                "presence": "required"
              }
            ],
            "returns": [{ "name": "error" }, { "name": "()" }]
          },
          {
            "name": "onFileDelete",
            "kind": "remote",
            "doc": "Invoked when a file disappears from the watched directory. There is no content or file metadata, because the file is already gone.",
            "presence": "optional",
            "annotations": ["$functionConfig"],
            "params": [
              {
                "name": "deleteFiles",
                "doc": "Path of the file that was deleted.",
                "type": { "name": "string" },
                "presence": "required"
              },
              {
                "name": "caller",
                "doc": "The FTP connection, for acting on the share in response to the deletion.",
                "type": { "name": "Caller" },
                "presence": "optional"
              }
            ],
            "returns": [{ "name": "error" }, { "name": "()" }]
          },
          {
            "name": "onError",
            "kind": "remote",
            "doc": "Invoked when the listener fails to poll, read, or bind a file, and when a handler itself returns an error. Without it, failures are logged and polling continues.",
            "presence": "optional",
            "annotations": ["$functionConfig"],
            "params": [
              {
                "name": "ftpError",
                "doc": "The failure that interrupted processing.",
                "type": { "name": "Error" },
                "presence": "required"
              },
              {
                "name": "caller",
                "doc": "The FTP connection, for acting on the share while handling the failure.",
                "type": { "name": "Caller" },
                "presence": "optional"
              }
            ],
            "returns": [{ "name": "error" }, { "name": "()" }]
          },
          {
            "name": "onFileChange",
            "kind": "remote",
            "doc": "Invoked once per poll with the complete set of files added and deleted since the previous poll.",
            "deprecated": "Superseded by the typed content handlers. onFileChange only reports which files changed, leaving the read and the parse to the handler, whereas onFileText, onFileJson, onFileXml, onFileCsv and onFile deliver the file body already bound to a declared type.",
            "presence": "optional",
            "annotations": ["$functionConfig"],
            "params": [
              {
                "name": "watchEvent",
                "doc": "The files added and deleted in this poll.",
                "type": { "name": "WatchEvent" },
                "presence": "required"
              }
            ],
            "returns": [{ "name": "error" }, { "name": "()" }]
          }
        ]
      },
      "rules": [
        {
          "id": "$eventVsFormatCsv",
          "rule": "structure.atMostOne",
          "message": "onFileChange and onFileCsv cannot coexist: onFileChange already reports every file in the poll, so the typed handler would process the same file twice.",
          "subjects": [{ "kind": "handler", "name": "onFileChange" }, { "kind": "handler", "name": "onFileCsv" }]
        },
        {
          "id": "$eventVsFormatJson",
          "rule": "structure.atMostOne",
          "message": "onFileChange and onFileJson cannot coexist: onFileChange already reports every file in the poll, so the typed handler would process the same file twice.",
          "subjects": [{ "kind": "handler", "name": "onFileChange" }, { "kind": "handler", "name": "onFileJson" }]
        },
        {
          "id": "$eventVsFormatXml",
          "rule": "structure.atMostOne",
          "message": "onFileChange and onFileXml cannot coexist: onFileChange already reports every file in the poll, so the typed handler would process the same file twice.",
          "subjects": [{ "kind": "handler", "name": "onFileChange" }, { "kind": "handler", "name": "onFileXml" }]
        },
        {
          "id": "$eventVsFormatText",
          "rule": "structure.atMostOne",
          "message": "onFileChange and onFileText cannot coexist: onFileChange already reports every file in the poll, so the typed handler would process the same file twice.",
          "subjects": [{ "kind": "handler", "name": "onFileChange" }, { "kind": "handler", "name": "onFileText" }]
        },
        {
          "id": "$eventVsFormatFile",
          "rule": "structure.atMostOne",
          "message": "onFileChange and onFile cannot coexist: onFileChange already reports every file in the poll, so the typed handler would process the same file twice.",
          "subjects": [{ "kind": "handler", "name": "onFileChange" }, { "kind": "handler", "name": "onFile" }]
        },
        {
          "id": "$eventVsFormatDelete",
          "rule": "structure.atMostOne",
          "message": "onFileChange and onFileDelete cannot coexist: onFileChange already reports every file in the poll, so the typed handler would process the same file twice.",
          "subjects": [{ "kind": "handler", "name": "onFileChange" }, { "kind": "handler", "name": "onFileDelete" }]
        },
        {
          "id": "$atLeastOneFileHandler",
          "rule": "structure.atLeastOne",
          "message": "An FTP service must declare at least one file handler. onError alone never receives a file, so the service would do nothing.",
          "subjects": [
            { "kind": "handler", "name": "onFileCsv" },
            { "kind": "handler", "name": "onFileJson" },
            { "kind": "handler", "name": "onFileXml" },
            { "kind": "handler", "name": "onFileText" },
            { "kind": "handler", "name": "onFile" },
            { "kind": "handler", "name": "onFileDelete" }
          ]
        }
      ]
    }
  ],

  "annotations": [
    { "id": "$serviceConfig", "type": { "name": "ServiceConfig" }, "attachPoint": "service", "presence": "required" },
    { "id": "$functionConfig", "type": { "name": "FunctionConfig" }, "attachPoint": "function", "presence": "optional" }
  ]
}
