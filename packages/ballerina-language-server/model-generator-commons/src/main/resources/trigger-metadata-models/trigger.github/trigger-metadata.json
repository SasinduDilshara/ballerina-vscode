{
  "version": "v1.0",

  "listeners": [
    {
      "type": { "name": "Listener" },
      "services": [
        "$issues",
        "$issueComment",
        "$pullRequest",
        "$pullRequestReview",
        "$pullRequestReviewComment",
        "$release",
        "$label",
        "$milestone",
        "$push",
        "$projectCard"
      ],
      "multipleServicesAllowed": true
    }
  ],

  "serviceTypes": [
    {
      "id": "$issues",
      "type": { "name": "IssuesService" },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": { "backedByConcreteType": true }
    },
    {
      "id": "$issueComment",
      "type": { "name": "IssueCommentService" },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": { "backedByConcreteType": true }
    },
    {
      "id": "$pullRequest",
      "type": { "name": "PullRequestService" },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": { "backedByConcreteType": true }
    },
    {
      "id": "$pullRequestReview",
      "type": { "name": "PullRequestReviewService" },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": { "backedByConcreteType": true }
    },
    {
      "id": "$pullRequestReviewComment",
      "type": { "name": "PullRequestReviewCommentService" },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": { "backedByConcreteType": true }
    },
    {
      "id": "$release",
      "type": { "name": "ReleaseService" },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": { "backedByConcreteType": true }
    },
    {
      "id": "$label",
      "type": { "name": "LabelService" },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": { "backedByConcreteType": true }
    },
    {
      "id": "$milestone",
      "type": { "name": "MilestoneService" },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": { "backedByConcreteType": true }
    },
    {
      "id": "$push",
      "type": { "name": "PushService" },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": { "backedByConcreteType": true }
    },
    {
      "id": "$projectCard",
      "type": { "name": "ProjectCardService" },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": { "backedByConcreteType": true }
    }
  ]
}
