{
  "version": "v1.0",

  "listeners": [
    { "type": { "name": "Listener" }, "services": ["$service"], "multipleServicesAllowed": false }
  ],

  "serviceTypes": [
    {
      "id": "$service",
      "type": { "name": "Service" },
      "concrete": false,
      "multipleListenersAllowed": false,
      "handlers": {
        "backedByConcreteType": false,
        "options": [
          {
            "name": "onConsumerRecord",
            "kind": "remote",
            "doc": "Invoked with each batch of records polled from the subscribed topics. The listener polls on its configured interval and dispatches everything it received as one batch.",
            "presence": "required",
            "params": [
              {
                "name": "caller",
                "doc": "Handle for committing offsets explicitly. Needed only when auto-commit is disabled.",
                "type": { "name": "Caller" },
                "presence": "optional"
              },
              {
                "name": "records",
                "doc": "The polled batch. Declare a narrower element type to project each record's value, see the consumerRecordPayload data-binding rule.",
                "type": [
                  { "shape": "array", "elementType": { "name": "AnydataConsumerRecord" } },
                  { "shape": "array", "elementType": { "name": "BytesConsumerRecord" } }
                ],
                "presence": "required",
                "annotations": ["$payload"],
                "dataBinding": {
                  "typedescs": [
                    {
                      "constraint": { "name": "anydata" },
                      "excludes": [{ "name": "AnydataConsumerRecord" }],
                      "shapes": [{ "form": "array", "element": "bare" }]
                    },
                    {
                      "constraint": { "name": "anydata" },
                      "shapes": [
                        {
                          "form": "array",
                          "element": "included",
                          "envelope": { "name": "AnydataConsumerRecord" },
                          "bindableFields": ["value"]
                        }
                      ]
                    }
                  ]
                }
              }
            ],
            "returns": [{ "name": "error" }, { "name": "()" }]
          },
          {
            "name": "onError",
            "kind": "remote",
            "doc": "Invoked when polling fails, or when a polled batch cannot be dispatched, most commonly because a record's value fails to bind to the declared type.",
            "presence": "optional",
            "params": [
              {
                "name": "err",
                "doc": "The failure that prevented the batch from being delivered.",
                "type": { "name": "Error" },
                "presence": "required"
              }
            ],
            "returns": [{ "name": "error" }, { "name": "()" }]
          }
        ]
      }
    }
  ],

  "annotations": [
    { "id": "$payload", "type": { "name": "Payload" }, "attachPoint": "parameter", "presence": "optional" }
  ]
}
