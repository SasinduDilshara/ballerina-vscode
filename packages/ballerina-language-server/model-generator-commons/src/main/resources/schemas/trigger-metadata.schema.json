{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wso2.com/ballerina/trigger-construct-spec/v1.0/spec.json",
  "title": "Ballerina Trigger Construct Spec",
  "description": "Authoring rules for a Ballerina trigger service. Carries only what library introspection cannot recover. See spec.md for the field reference.",
  "type": "object",
  "required": ["version", "listeners", "serviceTypes"],
  "additionalProperties": false,

  "properties": {
    "version": {
      "description": "Spec version this instance conforms to. Minor is additive, major is structural.",
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+$"
    },
    "listeners": { "description": "Listener entry points.", "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/listener" } },
    "serviceTypes": {
      "description": "Service type alternatives this connector exposes.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/serviceType" }
    },
    "annotations": {
      "description": "Annotation types referenced elsewhere, defined once.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/annotation" }
    },
    "rules": {
      "description": "Constraints spanning more than one service type. Every subject must name its serviceType.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },

  "$defs": {
    "id": {
      "description": "An identifier or a reference to one. Always starts with a dollar sign.",
      "type": "string",
      "pattern": "^\\$[A-Za-z][A-Za-z0-9_]*$"
    },
    "idList": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
    "presence": { "enum": ["required", "optional"] },
    "packageInfo": {
      "description": "The package a cross module type comes from.",
      "type": "object",
      "required": ["org", "packageName", "moduleName", "version"],
      "additionalProperties": false,
      "properties": {
        "org": { "type": "string" },
        "packageName": { "type": "string" },
        "moduleName": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "typeRef": {
      "description": "A type reference. Either a plain name, or a constructed type given by shape plus the parts that shape is built from. Every type inside a composite is itself a typeRef and can carry its own packageInfo.",
      "oneOf": [
        {
          "title": "named",
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "description": "Unqualified. It belongs to the module this file describes unless packageInfo is set. Composite types use shape, so a name never embeds [], <> or a trailing ?. Only () and record {} are non identifier names.",
              "type": "string",
              "pattern": "^(\\(\\)|record \\{\\}|[A-Za-z_][A-Za-z0-9_]*)$"
            },
            "packageInfo": { "$ref": "#/$defs/packageInfo" }
          }
        },
        {
          "title": "array",
          "description": "An array terminates with nothing, so it has no completionType.",
          "type": "object",
          "required": ["shape", "elementType"],
          "additionalProperties": false,
          "properties": {
            "shape": { "const": "array" },
            "elementType": { "description": "The element type.", "$ref": "#/$defs/typeRefOrUnion" }
          }
        },
        {
          "title": "stream",
          "type": "object",
          "required": ["shape", "elementType"],
          "additionalProperties": false,
          "properties": {
            "shape": { "const": "stream" },
            "elementType": { "description": "The value type.", "$ref": "#/$defs/typeRefOrUnion" },
            "completionType": { "description": "Optional. What the stream terminates with.", "$ref": "#/$defs/typeRefOrUnion" }
          }
        }
      ]
    },
    "typeRefOrUnion": {
      "description": "One type, or a union written as an array with the codegen default first.",
      "oneOf": [{ "$ref": "#/$defs/typeRef" }, { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/typeRef" } }]
    },
    "listener": {
      "type": "object",
      "required": ["type", "services", "multipleServicesAllowed"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "multipleServicesAllowed": { "const": false } }, "required": ["multipleServicesAllowed"] },
          "then": {
            "description": "With one service at most, two of the same type is already impossible.",
            "not": { "required": ["multipleServicesOfSameTypeAllowed"] }
          }
        }
      ],
      "properties": {
        "type": { "$ref": "#/$defs/typeRef" },
        "deprecated": {
          "description": "Why this construct is deprecated, as prose. A generator emitting Ballerina puts it in the # # Deprecated doc section.",
          "type": "string",
          "minLength": 1
        },
        "services": { "description": "serviceTypes ids this listener can host.", "$ref": "#/$defs/idList" },
        "multipleServicesAllowed": { "description": "Can one instance of this listener host more than one service at all?", "type": "boolean" },
        "multipleServicesOfSameTypeAllowed": { "description": "Can two of those services be of the same service type? Absent means unconstrained.", "type": "boolean" },
        "requiredImports": {
          "description": "Side effect only imports, never referenced by name.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/requiredImport" }
        },
        "platformDependencies": {
          "description": "Native dependencies declared in Ballerina.toml.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/platformDependency" }
        }
      }
    },
    "requiredImport": {
      "type": "object",
      "required": ["importType", "packageInfo"],
      "additionalProperties": false,
      "properties": { "importType": { "enum": ["driver"] }, "packageInfo": { "$ref": "#/$defs/packageInfo" } }
    },
    "platformDependency": {
      "description": "A jar the build must put on the classpath. No path here, that is the user's own copy.",
      "type": "object",
      "required": ["groupId", "artifactId", "version"],
      "additionalProperties": false,
      "properties": {
        "groupId": { "type": "string" },
        "artifactId": { "type": "string" },
        "version": { "description": "May be a wildcard pattern such as 3.1.*", "type": "string" },
        "scope": {
          "description": "provided keeps the jar compile time only, for example when a licence forbids bundling it.",
          "enum": ["provided"]
        },
        "acquisition": { "$ref": "#/$defs/acquisition" },
        "nativeLibraries": {
          "description": "OS specific libraries the JVM must load at run time.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nativeLibrary" }
        }
      }
    },
    "acquisition": {
      "description": "How to get an artifact no public repository serves.",
      "type": "object",
      "required": ["note"],
      "additionalProperties": false,
      "properties": { "url": { "type": "string", "format": "uri" }, "note": { "type": "string", "minLength": 1 } }
    },
    "nativeLibrary": {
      "description": "Where to put it is determined by os, so it is not repeated here.",
      "type": "object",
      "required": ["os", "file"],
      "additionalProperties": false,
      "properties": { "os": { "enum": ["linux", "windows", "macos"] }, "file": { "type": "string", "minLength": 1 } }
    },
    "serviceType": {
      "type": "object",
      "required": ["id", "type", "concrete", "multipleListenersAllowed", "handlers"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "$ref": "#/$defs/typeRef" },
        "deprecated": {
          "description": "Why this construct is deprecated, as prose. A generator emitting Ballerina puts it in the # # Deprecated doc section.",
          "type": "string",
          "minLength": 1
        },
        "concrete": { "description": "true when the type declares its own methods and they can be introspected.", "type": "boolean" },
        "multipleListenersAllowed": { "type": "boolean" },
        "annotations": { "description": "Annotation ids with attachPoint service.", "$ref": "#/$defs/idList" },
        "identifier": { "$ref": "#/$defs/identifierSpec" },
        "handlers": { "$ref": "#/$defs/handlers" },
        "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" } }
      }
    },
    "identifierSpec": {
      "description": "Present only when the identifier slot carries meaning.",
      "type": "object",
      "required": ["presence", "form"],
      "additionalProperties": false,
      "properties": {
        "presence": { "$ref": "#/$defs/presence" },
        "form": { "type": "array", "minItems": 1, "items": { "enum": ["basePath", "stringLiteral"] } }
      }
    },
    "handlers": {
      "type": "object",
      "required": ["backedByConcreteType"],
      "additionalProperties": false,
      "properties": {
        "backedByConcreteType": { "description": "true means the type's own methods are the handlers, so nothing more is said here.", "type": "boolean" },
        "options": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/handlerOption" } }
      },
      "allOf": [
        {
          "if": { "properties": { "backedByConcreteType": { "const": true } }, "required": ["backedByConcreteType"] },
          "then": { "description": "A concrete backed type omits options.", "not": { "required": ["options"] } },
          "else": { "required": ["options"] }
        }
      ]
    },
    "handlerOption": {
      "type": "object",
      "required": ["name", "kind", "doc"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "resource" } }, "required": ["kind"] },
          "then": { "description": "A resource function is identified by its accessor and path.", "required": ["accessor", "path"] },
          "else": {
            "description": "A remote function has neither.",
            "not": { "anyOf": [{ "required": ["accessor"] }, { "required": ["path"] }] }
          }
        },
        {
          "if": { "properties": { "addMode": { "const": "many" } }, "required": ["addMode"] },
          "then": {
            "description": "The user names each instance, so the name is always * and presence does not apply.",
            "properties": { "name": { "const": "*" } },
            "not": { "required": ["presence"] }
          }
        }
      ],
      "properties": {
        "name": { "description": "The handler method name, or * for an open handler.", "type": "string", "minLength": 1 },
        "kind": { "enum": ["remote", "resource"] },
        "addMode": {
          "description": "subset, the default when absent, is one fixed method name governed by presence. many is a shape the user instantiates repeatedly under names of their own choosing.",
          "enum": ["subset", "many"]
        },
        "doc": {
          "description": "What this handler is for and when it fires. Required: options only exist under a non concrete type, so there is no doc comment to introspect.",
          "type": "string",
          "minLength": 1
        },
        "deprecated": {
          "description": "Why this construct is deprecated, as prose. A generator emitting Ballerina puts it in the # # Deprecated doc section.",
          "type": "string",
          "minLength": 1
        },
        "presence": { "$ref": "#/$defs/presence" },
        "annotations": { "description": "Annotation ids with attachPoint function.", "$ref": "#/$defs/idList" },
        "returnAnnotations": { "description": "Annotation ids with attachPoint return.", "$ref": "#/$defs/idList" },
        "params": {
          "description": "Order is meaningful. A param that must come first is listed first.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/param" }
        },
        "returns": { "$ref": "#/$defs/typeRefOrUnion" },
        "accessor": {
          "description": "Resource kind only. The accessor in resource function <accessor> <path>().",
          "$ref": "#/$defs/valueSpec"
        },
        "path": { "description": "Resource kind only. The path in resource function <accessor> <path>().", "$ref": "#/$defs/valueSpec" }
      }
    },
    "valueSpec": {
      "description": "A constraint on one part of a resource handler's signature. No syntactic form is recorded, since the language already fixes what a resource path may look like.",
      "type": "object",
      "required": ["presence"],
      "additionalProperties": false,
      "properties": {
        "presence": { "$ref": "#/$defs/presence" },
        "values": {
          "description": "Legal literal values. A single * means any value the language accepts.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "param": {
      "type": "object",
      "required": ["type", "presence", "doc"],
      "additionalProperties": false,
      "properties": {
        "name": { "description": "The parameter name to emit.", "type": "string", "minLength": 1 },
        "doc": {
          "description": "What this parameter carries. Required for the same reason as a handler's doc. On a many slot it describes what one occurrence is.",
          "type": "string",
          "minLength": 1
        },
        "deprecated": {
          "description": "Why this construct is deprecated, as prose. A generator emitting Ballerina puts it in the # # Deprecated doc section.",
          "type": "string",
          "minLength": 1
        },
        "type": { "$ref": "#/$defs/typeRefOrUnion" },
        "presence": { "$ref": "#/$defs/presence" },
        "addMode": { "description": "many means the slot repeats, with the user naming each occurrence.", "enum": ["many"] },
        "dataBinding": { "$ref": "#/$defs/dataBinding" },
        "annotations": { "description": "Annotation ids with attachPoint parameter.", "$ref": "#/$defs/idList" }
      },
      "if": { "not": { "properties": { "addMode": { "const": "many" } }, "required": ["addMode"] } },
      "then": { "description": "A fixed slot must carry its name, otherwise each generator invents one.", "required": ["name"] }
    },
    "annotation": {
      "description": "attachPoint decides which construct field holds the reference to this id.",
      "type": "object",
      "required": ["id", "type", "attachPoint", "presence"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "$ref": "#/$defs/typeRef" },
        "attachPoint": { "enum": ["service", "function", "parameter", "return"] },
        "presence": { "$ref": "#/$defs/presence" }
      }
    },
    "rule": {
      "description": "A named constraint from an open registry. An unknown rule id is skipped, not failed.",
      "type": "object",
      "required": ["id", "rule", "subjects"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "rule": {
          "description": "Registry id, for example structure.exactlyOne. Open vocabulary.",
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*(\\.[a-zA-Z][A-Za-z0-9]*)+$"
        },
        "subjects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/subject" } },
        "severity": { "enum": ["error", "warning"], "default": "error" },
        "message": { "description": "Diagnostic text for a consumer to surface.", "type": "string", "minLength": 1 },
        "prefer": { "description": "Role a generator should default to. A hint, not part of the constraint.", "type": "string" }
      }
    },
    "subject": {
      "description": "What a rule ranges over. kind decides the shape.",
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "identifier" }, "serviceType": { "$ref": "#/$defs/id" }, "role": { "type": "string" } }
        },
        {
          "type": "object",
          "required": ["kind", "name"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "annotation" },
            "name": { "$ref": "#/$defs/id" },
            "serviceType": { "$ref": "#/$defs/id" },
            "role": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "annotation", "path"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "annotationField" },
            "annotation": { "$ref": "#/$defs/id" },
            "path": {
              "description": "Field path inside the annotation record. More than one entry for a nested field.",
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "serviceType": { "$ref": "#/$defs/id" },
            "role": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "name"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "handler" },
            "name": { "description": "A handler name, not an id.", "type": "string", "minLength": 1 },
            "serviceType": { "$ref": "#/$defs/id" },
            "role": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "handler", "name"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "param" },
            "handler": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "serviceType": { "$ref": "#/$defs/id" },
            "role": { "type": "string" }
          }
        }
      ]
    },
    "dataBinding": {
      "description": "Written inline on the param it belongs to. A set of independent typedesc variants that share nothing.",
      "type": "object",
      "required": ["typedescs"],
      "additionalProperties": false,
      "properties": { "typedescs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/typedescVariant" } } }
    },
    "typedescVariant": {
      "type": "object",
      "required": ["constraint", "shapes"],
      "additionalProperties": false,
      "properties": {
        "constraint": { "description": "This variant's typedesc upper bound. One type, never a union.", "$ref": "#/$defs/typeRef" },
        "excludes": {
          "description": "Instantiations another variant already owns, so each declared type maps to one variant.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/typeRef" }
        },
        "shapes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/shape" } }
      }
    },
    "shape": {
      "description": "How the bound type is embedded in the declared type.",
      "type": "object",
      "required": ["form"],
      "additionalProperties": false,
      "properties": {
        "form": {
          "description": "bare is T alone, array is T[], stream is a stream of T, included splices T into a field of an envelope record.",
          "enum": ["bare", "array", "stream", "included"]
        },
        "element": { "description": "For array and stream, whether each element is bare or included.", "enum": ["bare", "included"] },
        "envelope": { "$ref": "#/$defs/typeRef" },
        "bindableFields": {
          "description": "Fields of the envelope bound to this variant's typedesc. Every other field stays fixed.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "completionType": { "description": "A union with () when nilable.", "$ref": "#/$defs/typeRefOrUnion" }
      },
      "allOf": [
        {
          "if": { "properties": { "form": { "const": "included" } }, "required": ["form"] },
          "then": { "required": ["envelope", "bindableFields"] }
        },
        {
          "if": { "properties": { "form": { "enum": ["array", "stream"] } }, "required": ["form"] },
          "then": { "required": ["element"] }
        }
      ]
    }
  }
}
